---
import '@fontsource-variable/fraunces/soft.css';
import '@fontsource-variable/fraunces/soft-italic.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import Navegacao from '../components/Navegacao.astro';
import Contato from '../components/Contato.astro';
import ogPadrao from '../assets/og-padrao.jpg';
import site from '../data/site.json';
import { virada } from '../scripts/virada';

interface Props {
  titulo?: string;
  descricao?: string;
  imagemOg?: ImageMetadata;
}
const { titulo, descricao = site.descricao, imagemOg = ogPadrao } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${site.titulo}` : site.titulo;
// Prévia de link: recorte 1,91:1 e leve, porque o WhatsApp ignora imagens pesadas (~300KB).
// Fotos com menos de 1200px não são ampliadas: reduz a largura e mantém a proporção.
const ogLargura = Math.min(1200, imagemOg.width);
const ogAltura = Math.round((ogLargura * 630) / 1200);
const og = await getImage({ src: imagemOg, width: ogLargura, height: ogAltura, fit: 'cover', format: 'jpg', quality: 70 });
const ogUrl = new URL(og.src, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.titulo} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Navegacao />
    <main id="conteudo" transition:animate={virada}>
      <slot />
    </main>
    <Contato />
    <script>
      import '../scripts/animacoes/index.ts';
    </script>
  </body>
</html>
