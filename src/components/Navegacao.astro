---
// O site é uma página só: o menu leva às seções dela.
const links = [
  { href: '#sobre', texto: 'Sobre' },
  { href: '#croquis', texto: 'Croquis' },
  { href: '#contato', texto: 'Contato' },
];
---
<header class="nav">
  <div class="container nav__barra">
    <a href="/" class="nav__logo" aria-label="Beatriz — página inicial">B<span>eatriz</span></a>
    <nav aria-label="Principal">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.texto}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: var(--papel);
    border-bottom: 1px solid var(--linha);
  }
  .nav__barra {
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.75rem; flex-wrap: wrap; padding-block: 0.6rem;
  }
  .nav__logo {
    font-family: var(--fonte-display); font-size: 1.6rem; font-weight: 600;
    text-decoration: none; line-height: 1;
  }
  .nav__logo span { font-style: italic; font-weight: 400; }
  ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; list-style: none; margin: 0; padding: 0; }
  ul a:hover { color: var(--vermelho-texto); }
  ul a {
    font-size: 0.9rem; font-weight: 500;
    text-decoration: none;
  }
  /* No celular o menu quebra em duas linhas e, preso, tomaria boa parte da tela: lá ele rola junto. */
  @media (max-width: 767px) {
    .nav { position: relative; }
  }
  @media (min-width: 768px) {
    ul { gap: 2rem; }
    ul a { font-size: 0.95rem; }
  }
</style>
