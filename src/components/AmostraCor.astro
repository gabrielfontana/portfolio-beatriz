---
interface Props {
  hex: string;
  nome: string;
  chave: string;
  titulo: string;
  indice?: number;
}
const { hex, nome, chave, titulo, indice = 0 } = Astro.props;
---
<button
  type="button"
  class="amostra"
  data-amostra={chave}
  aria-pressed="false"
  aria-label={`Destacar ${nome} ${hex} no ${titulo}`}
  style={`--cor: ${hex}; --i: ${indice}`}
>
  <span class="amostra__bola" aria-hidden="true"></span>
  <span class="amostra__nome">{nome}</span>
  <span class="amostra__hex">{hex}</span>
</button>

<style>
  .amostra {
    display: grid; grid-template-columns: auto 1fr; column-gap: 0.6rem; align-items: center;
    width: 100%; padding: 0.35rem 0.5rem; border: 2px solid transparent; background: none;
    font: inherit; color: var(--tinta); text-align: left; cursor: pointer;
  }
  .amostra:hover, .amostra[aria-pressed='true'] { border-color: var(--tinta); }
  .amostra__bola {
    grid-row: span 2; width: 2.1rem; height: 2.1rem; border-radius: 50%;
    background: var(--cor); border: 1px solid var(--tinta);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .amostra:hover .amostra__bola, .amostra[aria-pressed='true'] .amostra__bola { transform: scale(1.15); }
  /* Look fora de foco no line-up: cores travadas até ele chegar ao centro. */
  .amostra[aria-disabled='true'] { opacity: 0.4; border-color: transparent; }
  .amostra[aria-disabled='true'] .amostra__bola { transform: scale(0.8); filter: saturate(0.4); }
  /* Ao entrar em foco, as bolinhas "acendem" em cascata para mostrar que já dá para tocar. */
  .amostra[aria-disabled='false'] { animation: amostra-liberar-texto 0.5s ease-out backwards; animation-delay: calc(var(--i) * 90ms); }
  .amostra[aria-disabled='false'] .amostra__bola {
    animation: amostra-liberar 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
    animation-delay: calc(var(--i) * 90ms);
  }
  @keyframes amostra-liberar {
    0% { transform: scale(0.8); box-shadow: 0 0 0 0 var(--cor); }
    45% { transform: scale(1.25); box-shadow: 0 0 0 0.45rem color-mix(in srgb, var(--cor) 35%, transparent); }
    100% { transform: scale(1); box-shadow: 0 0 0 0.9rem transparent; }
  }
  @keyframes amostra-liberar-texto {
    from { opacity: 0.4; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .amostra[aria-disabled='false'], .amostra[aria-disabled='false'] .amostra__bola { animation: none; }
  }
  .amostra__nome { font-family: var(--fonte-display); font-size: 1.05rem; line-height: 1.1; }
  .amostra__hex { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
</style>
