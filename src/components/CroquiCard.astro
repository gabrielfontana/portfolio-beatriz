---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import AmostraCor from './AmostraCor.astro';
import type { CorDaPaleta } from '../lib/croquis';

interface Props {
  id: string;
  titulo: string;
  alt: string;
  imagem: ImageMetadata;
  cores: Array<CorDaPaleta & { chave: string; mascara: ImageMetadata }>;
  /** Look vestido no manequim quando a página abre. */
  atual?: boolean;
}
const { id, titulo, alt, imagem, cores, atual = false } = Astro.props;
// Base e camadas de realce usam o MESMO arquivo, para baixar uma vez só.
const base = await getImage({ src: imagem, width: Math.min(800, imagem.width), format: 'webp' });
const mascaras = await Promise.all(cores.map((c) => getImage({ src: c.mascara, format: 'png' })));
---
<!-- Um look do provador. No manequim os looks ficam empilhados (o palco na mesma célula da grade,
     a paleta embaixo) e só o atual aparece; sem JS, viram uma grade com todos. -->
<article class="croqui" id={id} data-croqui data-atual={atual ? '' : undefined} aria-label={titulo}>
  <div class="croqui__palco" style={`aspect-ratio: ${imagem.width} / ${imagem.height}`}>
    <img
      class="croqui__base"
      src={base.src}
      alt={alt}
      width={base.attributes.width}
      height={base.attributes.height}
      loading={atual ? 'eager' : 'lazy'}
      decoding="async"
    />
    {cores.map((c, i) => (
      <img
        class="croqui__realce"
        data-realce={c.chave}
        src={base.src}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        style={`--mascara: url(${mascaras[i].src})`}
      />
    ))}
  </div>
  <ul class="croqui__paleta" aria-label={`Paleta do ${titulo}`}>
    {cores.map((c, i) => (
      <li><AmostraCor hex={c.hex} nome={c.nome} chave={c.chave} titulo={titulo} indice={i} /></li>
    ))}
  </ul>
</article>

<script>
  import '../scripts/destaque-cor.ts';
</script>

<style>
  .croqui { display: grid; gap: 0.75rem; align-content: start; }
  /* O palco tem fundo próprio (papel) e os desenhos se misturam a ele com multiply: o branco do
     JPEG some no papel e, empilhado no manequim, o look de cima cobre por inteiro o de baixo. */
  .croqui__palco { position: relative; width: 100%; background: var(--papel); isolation: isolate; }
  .croqui__base, .croqui__realce {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: fill; mix-blend-mode: multiply;
  }
  .croqui__base { transition: filter 0.3s, opacity 0.3s; }
  .croqui__palco[data-destacando] .croqui__base { filter: grayscale(1); opacity: 0.35; }
  .croqui__realce {
    pointer-events: none; opacity: 0; transition: opacity 0.3s;
    -webkit-mask-image: var(--mascara); mask-image: var(--mascara);
    -webkit-mask-size: 100% 100%; mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
  }
  .croqui__realce.ativo { opacity: 1; }
  .croqui__paleta { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); gap: 0.25rem; }

  @media (prefers-reduced-motion: reduce) {
    .croqui__base, .croqui__realce { transition: none; }
  }
</style>
