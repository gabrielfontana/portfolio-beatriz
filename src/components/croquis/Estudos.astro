---
interface Anotacao {
  x: number;
  y: number;
  texto: string;
}
interface Estudo {
  id: string;
  src: string;
  mini: string;
  largura: number;
  altura: number;
  alt: string;
  anotacoes: Anotacao[];
}
interface Props {
  estudos: Estudo[];
}
const { estudos } = Astro.props;
---
<!-- Leitura guiada: pontos numerados sobre as anotações; tocar num ponto (ou seguir em ordem) aproxima
     a prancha até ali e mostra o texto legível. Sem JS: todas as pranchas, com as anotações em lista. -->
<div class="estudos" data-estudos>
  {estudos.map((e, k) => (
    <article class="estudo" id={e.id} data-estudo data-atual={k === 0 ? '' : undefined} aria-label={`Estudo ${k + 1} de ${estudos.length}`}>
      <div class="estudo__quadro" data-quadro style={`--ar: ${e.largura} / ${e.altura}`}>
        <div class="estudo__camada" data-camada>
          <img src={e.src} alt={e.alt} width={e.largura} height={e.altura} loading="lazy" decoding="async" />
          {e.anotacoes.map((a, i) => (
            <button type="button" class="estudo__ponto" data-ponto={i} style={`left: ${a.x}%; top: ${a.y}%`} aria-label={`Anotação ${i + 1}`}>
              {i + 1}
            </button>
          ))}
        </div>
      </div>
      <div class="estudo__painel">
        <p class="estudo__contador" data-contador hidden></p>
        <p class="estudo__texto" data-texto aria-live="polite" hidden></p>
        <div class="estudo__botoes" data-so-js hidden>
          <button type="button" class="estudo__botao" data-anterior>Anterior</button>
          <button type="button" class="estudo__botao estudo__botao--principal" data-proxima>Começar</button>
        </div>
        <button type="button" class="estudo__inteira" data-inteira hidden>Ver a prancha inteira</button>
        <ol class="estudo__lista" data-lista>
          {e.anotacoes.map((a) => <li>{a.texto}</li>)}
        </ol>
      </div>
    </article>
  ))}
  <div class="estudos__seletor" data-seletor data-so-js role="group" aria-label="Escolher estudo" hidden>
    {estudos.map((e, k) => (
      <button type="button" data-ir={k} aria-label={`Estudo ${k + 1}`} aria-current={k === 0 ? 'true' : 'false'}>
        <img src={e.mini} alt="" loading="lazy" decoding="async" />
      </button>
    ))}
  </div>
</div>

<style>
  .estudos { display: grid; gap: 3rem; }
  .estudo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem); gap: clamp(1.25rem, 3vw, 2.5rem); align-items: center; }
  /* A largura vem da proporção (com teto de altura): o ponto em % fica sempre sobre a anotação. */
  .estudo__quadro {
    position: relative; justify-self: center; width: min(100%, calc(min(78vh, 760px) * var(--ar)));
    aspect-ratio: var(--ar); overflow: hidden; background: #fff; box-shadow: 0 2px 10px #0000001a;
  }
  .estudo__camada { position: absolute; inset: 0; transform-origin: 0 0; transition: transform 0.7s cubic-bezier(0.3, 0.8, 0.2, 1); }
  .estudo__camada img { width: 100%; height: 100%; object-fit: contain; display: block; }
  /* os pontos não crescem com o zoom */
  .estudo__ponto {
    position: absolute; display: grid; place-items: center; width: 28px; height: 28px; padding: 0;
    border: 2px solid #fff; border-radius: 50%; background: var(--tinta); color: #fff; font: 700 0.8rem/1 var(--fonte-texto);
    box-shadow: 0 2px 6px #0004; cursor: pointer;
    transform: translate(-50%, -50%) scale(calc(1 / var(--s, 1)));
    transition: transform 0.7s cubic-bezier(0.3, 0.8, 0.2, 1), background-color 0.2s;
  }
  .estudo__ponto[aria-current='true'] { background: var(--vermelho-texto); }
  .estudo__painel { display: grid; gap: 0.9rem; align-content: center; }
  .estudo__contador { margin: 0; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; }
  .estudo__texto { margin: 0; font-family: var(--fonte-display); font-size: clamp(1.15rem, 2vw, 1.45rem); line-height: 1.45; min-height: 5.8em; }
  .estudo__botoes { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .estudo__botoes[hidden], .estudo__contador[hidden], .estudo__texto[hidden], .estudo__inteira[hidden] { display: none; }
  .estudo__botao { font: 700 0.85rem/1 var(--fonte-texto); padding: 0.65rem 1.1rem; border: 2px solid var(--tinta); background: var(--papel); color: var(--tinta); cursor: pointer; }
  .estudo__botao--principal, .estudo__botao:hover { background: var(--tinta); color: var(--papel); }
  .estudo__botao:disabled { opacity: 0.35; cursor: default; background: var(--papel); color: var(--tinta); }
  .estudo__inteira { justify-self: start; padding: 0.2rem 0; border: 0; background: none; font: inherit; font-size: 0.9rem; text-decoration: underline; cursor: pointer; color: var(--tinta); }
  .estudo__lista { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; }

  /* Com o script: uma prancha por vez; a lista continua lá para leitores de tela. */
  .estudos--ativo .estudo:not([data-atual]) { display: none; }
  .estudos--ativo .estudo__lista { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .estudos__seletor { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; }
  .estudos__seletor[hidden] { display: none; }
  .estudos__seletor button { width: 58px; height: 74px; padding: 3px; background: #fff; border: 2px solid transparent; box-shadow: 0 1px 4px #0002; cursor: pointer; }
  .estudos__seletor button[aria-current='true'] { border-color: var(--tinta); }
  .estudos__seletor img { width: 100%; height: 100%; object-fit: contain; display: block; }

  @media (max-width: 767px) {
    .estudo { grid-template-columns: 1fr; }
    .estudo__quadro { width: min(100%, calc(42svh * var(--ar))); }
    .estudo { scroll-margin-top: calc(var(--altura-menu, 3.3rem) + 3.5rem); }
    .estudo__texto { min-height: 4.4em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .estudo__camada, .estudo__ponto { transition: none; }
  }
</style>
