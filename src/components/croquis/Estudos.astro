---
interface Anotacao {
  x: number;
  y: number;
  texto: string;
}
interface Estudo {
  id: string;
  src: string;
  mini: string;
  largura: number;
  altura: number;
  alt: string;
  anotacoes: Anotacao[];
}
interface Props {
  estudos: Estudo[];
}
const { estudos } = Astro.props;
---
<!-- Leitura guiada: "Próximo" aproxima a prancha, um detalhe por vez, sem texto nem marcação por cima.
     Os pontos (x, y das anotações) ficam escondidos e só dizem para onde o zoom vai.
     Sem JS: todas as pranchas inteiras, uma embaixo da outra. -->
<div class="estudos" data-estudos>
  {estudos.map((e, k) => (
    <article class="estudo" id={e.id} data-estudo data-atual={k === 0 ? '' : undefined} aria-label={`Estudo ${k + 1} de ${estudos.length}`}>
      <div class="estudo__quadro" data-quadro style={`--ar: ${e.largura} / ${e.altura}`}>
        <div class="estudo__camada" data-camada>
          <img src={e.src} alt={e.alt} width={e.largura} height={e.altura} loading="lazy" decoding="async" />
          {e.anotacoes.map((a, i) => (
            <span data-ponto={i} style={`left: ${a.x}%; top: ${a.y}%`} hidden></span>
          ))}
        </div>
      </div>
      <div class="estudo__painel" data-so-js hidden>
        <p class="sr-only" data-contador aria-live="polite"></p>
        <div class="estudo__botoes">
          <button type="button" class="estudo__botao" data-anterior>Anterior</button>
          <button type="button" class="estudo__botao estudo__botao--principal" data-proxima>Começar</button>
        </div>
        <button type="button" class="estudo__inteira" data-inteira hidden>Ver a prancha inteira</button>
      </div>
    </article>
  ))}
  <div class="estudos__seletor" data-seletor data-so-js role="group" aria-label="Escolher estudo" hidden>
    {estudos.map((e, k) => (
      <button type="button" data-ir={k} aria-label={`Estudo ${k + 1}`} aria-current={k === 0 ? 'true' : 'false'}>
        <img src={e.mini} alt="" loading="lazy" decoding="async" />
      </button>
    ))}
  </div>
</div>

<style>
  .estudos { display: grid; gap: 3rem; }
  .estudo { display: grid; gap: 1.25rem; justify-items: center; }
  /* A largura vem da proporção (com teto de altura): o zoom em % cai sempre sobre a anotação. */
  .estudo__quadro {
    position: relative; width: min(100%, calc(min(78vh, 760px) * var(--ar)));
    aspect-ratio: var(--ar); overflow: hidden; background: #fff; box-shadow: 0 2px 10px #0000001a;
  }
  .estudo__camada { position: absolute; inset: 0; transform-origin: 0 0; transition: transform 0.7s cubic-bezier(0.3, 0.8, 0.2, 1); }
  .estudo__camada img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .estudo__painel { display: grid; gap: 0.6rem; justify-items: center; }
  .estudo__painel[hidden], .estudo__inteira[hidden] { display: none; }
  .estudo__botoes { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; }
  .estudo__botao { font: 600 0.9rem/1 var(--fonte-texto); padding: 0.65rem 1.2rem; border: 1px solid var(--tinta); border-radius: 999px; background: var(--papel); color: var(--tinta); cursor: pointer; }
  .estudo__botao--principal, .estudo__botao:hover { background: var(--tinta); color: var(--papel); }
  .estudo__botao:disabled { opacity: 0.35; cursor: default; background: var(--papel); color: var(--tinta); }
  .estudo__inteira { padding: 0.2rem 0; border: 0; background: none; font: inherit; font-size: 0.9rem; text-decoration: underline; cursor: pointer; color: var(--tinta); }

  /* Com o script: uma prancha por vez. */
  .estudos--ativo .estudo:not([data-atual]) { display: none; }
  .estudos__seletor { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; }
  .estudos__seletor[hidden] { display: none; }
  .estudos__seletor button { width: 58px; height: 74px; padding: 3px; background: #fff; border: 1px solid transparent; border-radius: 4px; box-shadow: 0 1px 4px #0002; cursor: pointer; }
  .estudos__seletor button[aria-current='true'] { border-color: var(--tinta); }
  .estudos__seletor img { width: 100%; height: 100%; object-fit: contain; display: block; }

  @media (max-width: 767px) {
    .estudo__quadro { width: min(100%, calc(52svh * var(--ar))); }
    .estudo { scroll-margin-top: calc(var(--altura-menu, 3.3rem) + 3.5rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .estudo__camada { transition: none; }
  }
</style>
