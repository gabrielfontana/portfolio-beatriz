---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Revista from '../layouts/Revista.astro';
import Provador from '../components/croquis/Provador.astro';
import DesenhoAoVivo from '../components/croquis/DesenhoAoVivo.astro';
import Varal from '../components/croquis/Varal.astro';
import Visualizador from '../components/croquis/Visualizador.astro';
import Estudos from '../components/croquis/Estudos.astro';
import logoSketchbook from '../assets/croquis/logo-sketchbook.png';
import { faixaDaColecao, resolverMascaras } from '../lib/croquis';

// ---------- Sketchbook: um manequim por pose ----------
const mapaMascaras = import.meta.glob<ImageMetadata>('/src/content/croquis/*/mascara-*.png', { eager: true, import: 'default' });
const looks = (await getCollection('croquis')).sort((a, b) => a.data.ordem - b.data.ordem);
const manequins = (['a', 'b', 'c'] as const)
  .map((pose) =>
    looks
      .filter((l) => l.data.pose === pose)
      .map((l) => ({ id: l.id, titulo: l.data.titulo, alt: l.data.alt, imagem: l.data.imagem, cores: resolverMascaras(l.id, l.data.paleta, mapaMascaras) })),
  )
  .filter((m) => m.length > 0);
const faixa = faixaDaColecao(looks.map((l) => l.data));

// ---------- À mão ----------
const camadas = import.meta.glob<string>('/src/content/desenhos/*/{lapis,tempo}.png', { eager: true, query: '?url', import: 'default' });
const camada = (id: string, nome: 'lapis' | 'tempo') => {
  const url = camadas[`/src/content/desenhos/${id}/${nome}.png`];
  if (!url) throw new Error(`Falta ${nome}.png em desenhos/${id} (desenho ao vivo): rode npm run croquis`);
  return url;
};
const desenhos = (await getCollection('desenhos')).sort((a, b) => a.data.ordem - b.data.ordem);
/** Folhas para o visualizador: imagem grande (lupa), miniatura e se tem cor (controle traço ↔ cor). */
async function dadosDoVisor(folhas: Array<{ imagem: ImageMetadata; alt: string }>, colorido: boolean) {
  const lista = await Promise.all(
    folhas.map(async (f) => {
      const grande = await getImage({ src: f.imagem, width: Math.min(1600, f.imagem.width), format: 'webp' });
      const mini = await getImage({ src: f.imagem, width: 120, format: 'webp' });
      return { src: grande.src, mini: mini.src, largura: f.imagem.width, altura: f.imagem.height, alt: f.alt, colorido };
    }),
  );
  return JSON.stringify(lista);
}
const aoVivo = await Promise.all(
  desenhos
    .filter((d) => d.data.aoVivo)
    .map(async (d) => ({
      id: d.id,
      folhas: d.data.folhas,
      lapis: camada(d.id, 'lapis'),
      tempo: camada(d.id, 'tempo'),
      visor: await dadosDoVisor(d.data.folhas, d.data.tipo === 'colorido'),
    })),
);
// No varal, os rascunhos a lápis vão por último.
const doVaral = [...desenhos.filter((d) => !d.data.aoVivo && d.data.tipo === 'colorido'), ...desenhos.filter((d) => !d.data.aoVivo && d.data.tipo === 'rascunho')];
const varal = await Promise.all(
  doVaral.map(async (d) => ({
    id: d.id,
    tipo: d.data.tipo,
    folhas: await Promise.all(
      d.data.folhas.map(async (f) => {
        const img = await getImage({ src: f.imagem, width: Math.min(500, f.imagem.width), format: 'webp' });
        return { src: img.src, largura: f.imagem.width, altura: f.imagem.height, alt: f.alt };
      }),
    ),
    visor: await dadosDoVisor(d.data.folhas, d.data.tipo === 'colorido'),
  })),
);

// ---------- Estudos ----------
const estudos = await Promise.all(
  (await getCollection('estudos'))
    .sort((a, b) => a.data.ordem - b.data.ordem)
    .map(async (e) => {
      const { imagem } = e.data;
      const grande = await getImage({ src: imagem, width: Math.min(2000, imagem.width), format: 'webp' });
      const mini = await getImage({ src: imagem, width: 120, format: 'webp' });
      return { id: e.id, src: grande.src, mini: mini.src, largura: imagem.width, altura: imagem.height, alt: e.data.alt, anotacoes: e.data.anotacoes };
    }),
);

const logo = await getImage({ src: logoSketchbook, width: 96, format: 'png' });
---
<Revista
  titulo="Croquis"
  descricao="Croquis de Beatriz: looks desenhados no app Sketchbook, desenhos à mão em marcador e lápis, e estudos com as anotações de modelagem."
  imagemOg={looks[0]?.data.imagem}
>
  <div data-pagina-croquis>
    <header class="container croquis-topo">
      <p class="kicker">Do app ao papel</p>
      <h1 data-anim="revelar">Croquis</h1>
      <p class="croquis-topo__linha">
        Looks desenhados no Sketchbook e no papel, e os estudos por trás deles.
      </p>
    </header>
    <div class="faixa" aria-hidden="true">
      {faixa.map((hex) => <span style={`--cor: ${hex}`}></span>)}
    </div>

    <nav class="abas" aria-label="Seções da página" data-abas>
      <div class="container abas__lista">
        <a href="#sketchbook" data-aba="sketchbook"><img src={logo.src} alt="" width="22" height="22" />Sketchbook</a>
        <a href="#a-mao" data-aba="a-mao">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1-5L16 4l4 4L9 19z" /><path d="M14 6l4 4" /></svg>À mão
        </a>
        <a href="#estudos" data-aba="estudos"><img src={logo.src} alt="" width="22" height="22" />Estudos</a>
      </div>
    </nav>

    <section class="capitulo container" id="sketchbook" aria-labelledby="t-sketchbook">
      <div class="capitulo__titulo">
        <img src={logo.src} alt="" width="48" height="48" />
        <div>
          <h2 id="t-sketchbook">Desenhados no Sketchbook</h2>
          <p>Toque na figura para trocar a roupa. Toque numa cor para ver onde ela está.</p>
        </div>
      </div>
      <Provador manequins={manequins} />
    </section>

    <!-- Seção de largura total: a mesa de luz vai de ponta a ponta; título e varal no container. -->
    <section class="capitulo capitulo--largo" id="a-mao" aria-labelledby="t-a-mao">
      <div class="container capitulo__titulo">
        <span class="capitulo__icone" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 20l1-5L16 4l4 4L9 19z" /><path d="M14 6l4 4" /></svg>
        </span>
        <div>
          <h2 id="t-a-mao">Desenhados à mão</h2>
          <p>Marcador, lápis de cor e grafite no papel. Toque numa folha para ver de perto.</p>
        </div>
      </div>
      {aoVivo.map((d) => <DesenhoAoVivo {...d} />)}
      <div class="container"><Varal grupos={varal} /></div>
    </section>

    <section class="capitulo container" id="estudos" aria-labelledby="t-estudos">
      <div class="capitulo__titulo">
        <img src={logo.src} alt="" width="48" height="48" />
        <div>
          <h2 id="t-estudos">Estudos no Sketchbook</h2>
          <p>Medidas, referências e dúvidas anotadas durante a criação. Siga as anotações uma a uma.</p>
        </div>
      </div>
      <Estudos estudos={estudos} />
    </section>

    <Visualizador />
  </div>
</Revista>

<script>
  import '../scripts/croquis/index.ts';
</script>

<style>
  .croquis-topo { padding-block: 3rem 1.5rem; }
  .croquis-topo__linha { max-width: 48ch; font-size: 1.15rem; margin-top: 1rem; }
  .faixa { display: flex; height: 18px; margin-bottom: 0; }
  .faixa span { flex: 1; background: var(--cor); }

  /* Abas presas logo abaixo do menu (a altura do menu vem do script; o valor é só o padrão). */
  .abas {
    position: sticky; top: var(--altura-menu, 3.3rem); z-index: 40;
    background: var(--papel); border-bottom: 1px solid #14141433;
  }
  .abas__lista { display: flex; gap: 0.25rem; padding-top: 0.5rem; overflow-x: auto; scrollbar-width: none; }
  .abas a {
    display: flex; align-items: center; gap: 0.5rem; flex: none; padding: 0.55rem 0.9rem;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-decoration: none; color: var(--tinta);
    border: 1px solid transparent; border-bottom: 0;
  }
  .abas a:hover { color: var(--vermelho-texto); }
  .abas a[aria-current='true'] { background: #fff; border-color: #14141433; }
  .abas img { width: 22px; height: 22px; border-radius: 5px; }
  .abas svg, .capitulo__icone svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .abas svg { width: 18px; height: 18px; }
  /* no celular o menu rola junto: as abas ficam no topo da tela, mais baixas */
  @media (max-width: 767px) {
    .abas { top: 0; }
    .capitulo { scroll-margin-top: 3rem; }
    .abas__lista { padding-top: 0.3rem; }
    .abas a { padding: 0.4rem 0.6rem; font-size: 0.72rem; gap: 0.35rem; }
    .abas img { width: 18px; height: 18px; }
  }

  /* Cada seção para logo abaixo do menu + abas ao chegar pela aba. */
  .capitulo { padding-block: 3rem 4.5rem; scroll-margin-top: calc(var(--altura-menu, 3.3rem) + 3.2rem); }
  .capitulo + .capitulo { border-top: 2px solid var(--tinta); }
  /* a borda de cima acompanha a largura do container, como nas outras seções */
  .capitulo--largo { border-top: 0 !important; background: linear-gradient(var(--tinta), var(--tinta)) top / min(100% - 2 * var(--gutter), var(--max)) 2px no-repeat; }
  .capitulo__titulo { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
  .capitulo__titulo img { width: 48px; height: 48px; border-radius: 11px; flex: none; }
  .capitulo__titulo h2 { margin: 0; }
  .capitulo__titulo p { margin: 0.35rem 0 0; max-width: 60ch; }
  .capitulo__icone { display: grid; place-items: center; width: 48px; height: 48px; flex: none; border: 2px solid var(--tinta); border-radius: 11px; }
  .capitulo__icone svg { width: 26px; height: 26px; }
  /* O desenho ao vivo vai de ponta a ponta; o varal vem depois dele. */
  #a-mao :global(.ao-vivo:first-of-type) { margin-top: 0.5rem; }
  #a-mao :global(.varal) { margin-top: 3rem; }
</style>
