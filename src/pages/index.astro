---
// O site é uma página só: abre com um trecho do sobre, segue com os croquis e fecha com o contato
// (o contato é o rodapé do layout, em src/components/Contato.astro).
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Revista from '../layouts/Revista.astro';
import SecaoCroquis from '../components/croquis/SecaoCroquis.astro';

const sobre = await getEntry('sobre', 'sobre');
if (!sobre) throw new Error('Crie src/content/sobre/sobre.md');
const { Content } = await render(sobre);
const d = sobre.data;
const primeiroLook = (await getCollection('croquis')).sort((a, b) => a.data.ordem - b.data.ordem)[0];
---
<Revista imagemOg={primeiroLook?.data.imagem}>
  <section class="container sobre" id="sobre" aria-labelledby="t-sobre">
    <div class="sobre__foto">
      <Image
        src={d.retrato}
        alt={d.retratoAlt}
        widths={[400, 700, 1000]}
        sizes="(min-width: 768px) 40vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="sobre__texto">
      <h1 id="t-sobre" data-anim="revelar">{d.nome}</h1>
      <p class="sobre__cargo">{d.cargo} · {d.cidade}</p>
      <div class="sobre__lide"><Content /></div>
      <ul class="sobre__habilidades" aria-label="Habilidades">
        {d.habilidades.map((h) => <li>{h}</li>)}
      </ul>
      <a class="botao" href="/cv-beatriz.pdf" download>Baixar currículo (PDF)</a>
    </div>
  </section>

  <SecaoCroquis />
</Revista>

<style>
  .sobre { display: grid; gap: 2rem; padding-block: 2.5rem 3.5rem; scroll-margin-top: var(--altura-menu, 3.3rem); }
  .sobre__foto { overflow: hidden; aspect-ratio: 4 / 5; border-radius: 4px; box-shadow: 0 2px 14px #0000001f; }
  .sobre__foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .sobre__texto h1 { margin-block: 0.5rem; }
  .sobre__cargo { font-family: var(--fonte-display); font-style: italic; font-size: 1.35rem; color: var(--grafite); margin: 0 0 1.5rem; }
  .sobre__lide { font-size: 1.2rem; max-width: 52ch; margin-bottom: 1.5rem; }
  .sobre__habilidades { list-style: none; margin: 0 0 2rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .sobre__habilidades li { padding: 0.3rem 0.8rem; border: 1px solid var(--linha); border-radius: 999px; font-size: 0.85rem; }
  @media (min-width: 768px) {
    .sobre { grid-template-columns: 1fr 1.2fr; align-items: center; gap: 4rem; }
    .sobre__foto { max-height: 78vh; }
  }
</style>
